{
  "name": "nova-stream-lg-webos",
  "version": "0.1.0",
  "private": true,
  "description": "LG webOS IPK launcher for the Nova Stream hosted Web App.",
  "scripts": {
    "prepare": "node scripts/fetch-webostvjs.mjs",
    "package": "ares-package . -o dist",
    "install:tv": "ares-install -d $DEVICE dist/tv.novastream.app_*.ipk",
    "launch:tv": "ares-launch -d $DEVICE tv.novastream.app",
    "inspect:tv": "ares-inspect -d $DEVICE -a tv.novastream.app",
    "logs:tv": "ares-shell -d $DEVICE -r 'journalctl -f -t WebAppMgr'",
    "uninstall:tv": "ares-install -d $DEVICE -r tv.novastream.app",
    "preview": "npx --yes serve -l 5050 ."
  },
  "devDependencies": {
    "@webosose/ares-cli": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
